name: ci
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-24.04
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_DB: hada
          POSTGRES_USER: hada
          POSTGRES_PASSWORD: integration-password
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U hada -d hada"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 10
      valkey:
        image: valkey/valkey:8-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "valkey-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 10
    env:
      HADA_INTEGRATION_DSN: postgresql://hada:integration-password@127.0.0.1:5432/hada
      HADA_INTEGRATION_VALKEY_URL: redis://127.0.0.1:6379/0
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - run: pip install -e '.[dev]'
      - run: ruff format --check .
      - run: ruff check .
      - run: mypy src
      - run: pytest -q --cov=hada --cov-report=term-missing --cov-fail-under=70
      - run: docker compose -f deploy/compose/compose.yaml --env-file .env.example config >/dev/null
      - name: Validate Grafana Alloy configuration
        run: >-
          docker run --rm
          -v "$PWD/deploy/alloy/config.alloy:/etc/alloy/config.alloy:ro"
          grafana/alloy:v1.12.0
          validate /etc/alloy/config.alloy
      - run: docker build --tag hada:test .
