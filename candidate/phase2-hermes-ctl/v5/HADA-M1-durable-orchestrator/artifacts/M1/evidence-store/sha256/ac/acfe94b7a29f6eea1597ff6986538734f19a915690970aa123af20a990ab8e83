logging {
  level  = "info"
  format = "json"
}

local.file_match "docker_logs" {
  path_targets = [
    {
      "__path__" = "/var/lib/docker/containers/*/*-json.log",
      "job"      = "docker",
      "host"     = sys.env("HOSTNAME"),
    },
  ]
  sync_period = "10s"
}

loki.source.file "docker_logs" {
  targets       = local.file_match.docker_logs.targets
  forward_to    = [loki.process.docker_json.receiver]
  tail_from_end = true
}

loki.process "docker_json" {
  stage.json {
    expressions = {
      output    = "log",
      stream    = "stream",
      timestamp = "time",
    }
  }

  stage.labels {
    values = {
      stream = "",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.output {
    source = "output"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
