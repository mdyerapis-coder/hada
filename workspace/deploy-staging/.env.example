# HADA deployment environment example — contains no live credentials.
# Copy to .env on the deployment host and provide real values there only.
HADA_ENV=production
HADA_DOMAIN=localhost
HADA_ACME_EMAIL=operator@example.invalid
POSTGRES_DB=hada
POSTGRES_USER=hada
POSTGRES_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
HADA_CONFIG=/opt/hada/config/hada.yaml
HADA_STATE_DIR=/var/lib/hada
HADA_LOG_DIR=/var/log/hada
HADA_DATABASE_DSN=postgresql://hada:CHANGE_ME@postgres:5432/hada
HADA_VALKEY_URL=redis://:CHANGE_ME@valkey:6379/0
HADA_TARGET_REPO_URL=https://github.com/mdyerapis-coder/hada
HADA_TARGET_REPO_REF=main
HADA_EXTERNAL_REVIEW_MODE=automated
HADA_INFERENCE_BACKEND=opencode-zen
HADA_INFERENCE_BASE_URL=https://opencode.ai/zen/v1
HADA_INFERENCE_MODEL_PATH=deepseek-v4-flash-free
HADA_INFERENCE_API_KEY=CHANGE_ME
