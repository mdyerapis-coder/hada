# HADA M1 deployment reference — REDACTED. Do NOT put real secrets here.
# Copy to /opt/hada/.env on the target and fill in real generated values.
# This file is committed for documentation only; the real .env is gitignored.

HADA_ENV=production
HADA_DOMAIN=localhost
HADA_ACME_EMAIL=

POSTGRES_DB=hada
POSTGRES_USER=hada
POSTGRES_PASSWORD=__GENERATED_32_BYTE_HEX__

VALKEY_PASSWORD=__GENERATED_32_BYTE_HEX__

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATED_32_BYTE_HEX__

HADA_CONFIG=/opt/hada/config/hada.yaml
HADA_STATE_DIR=/var/lib/hada
HADA_LOG_DIR=/var/log/hada

HADA_DATABASE_DSN=postgresql://hada:__POSTGRES_PASSWORD__@postgres:5432/hada
HADA_VALKEY_URL=redis://:__VALKEY_PASSWORD__@valkey:6379/0

# External review: automated (no human-in-loop) for this deployment
HADA_EXTERNAL_REVIEW_MODE=automated

# --- Inference backend (OpenCode Zen free models) ---
# Real key lives in Bitwarden item "OPENCODE_ZEN_API_KEY" (custom field 'token').
# NEVER commit the real value. Supply it on the target only.
HADA_INFERENCE_BACKEND=opencode-zen
HADA_INFERENCE_BASE_URL=https://opencode.ai/zen/v1
HADA_INFERENCE_API_KEY=__REDACTED_ZEN_API_KEY__
HADA_INFERENCE_MODEL_PATH=

# Target repository for the autonomous repair pipeline
HADA_TARGET_REPO_URL=https://github.com/mdyerapis-coder/hada
HADA_TARGET_REPO_REF=main
